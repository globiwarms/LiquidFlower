{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LiquidFlower",
  "version": "1.3.0",
  "identifier": "com.liquidflower.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "overlay",
        "url": "overlay.html",
        "width": 480,
        "height": 480,
        "visible": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false,
        "shadow": false,
        "closable": false,
        "dragDropEnabled": false
      },
      {
        "label": "settings",
        "url": "settings.html",
        "width": 1020,
        "height": 700,
        "minWidth": 920,
        "minHeight": 620,
        "visible": false,
        "transparent": true,
        "decorations": false,
        "resizable": true,
        "shadow": false,
        "title": "LiquidFlower",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
